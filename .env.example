# Copy to .env and fill in. Never commit .env -- it is git-ignored (R1.1).
# Secrets live only in the environment; config/*.yaml never contains a credential.

# --- LLM access ----------------------------------------------------------------------------
# Keys only. Endpoints live in config/model_routing.yaml -> talos.providers, which names the
# variable each key comes from; nothing here is read except by that mapping.
# NVIDIA NIM, primary for most tiers. Get a key at https://build.nvidia.com
TALOS_NIM_API_KEY=

# Fallback providers. Routing decides per agent which one answers when NIM fails
# (config/model_routing.yaml -> talos.providers); all three speak the OpenAI dialect.
# Groq: no card, no training clause, 200K tokens/day per model.
TALOS_GROQ_API_KEY=
# Mistral: free "Experiment" tier, ~1B tokens/month, requires opting in to data training.
TALOS_MISTRAL_API_KEY=

# --- Runtime ------------------------------------------------------------------------------
# Directory holding default.yaml, thresholds.yaml, and model_routing.yaml. Defaults to the
# repository's config/ directory; set it only when running from outside the repo.
TALOS_CONFIG_DIR=config
# Overlay applied on top of the files above; git-ignored when it exists.
TALOS_CONFIG_PATH=config/local.yaml
# One of: DEBUG | INFO | WARNING | ERROR
TALOS_LOG_LEVEL=INFO

# --- Storage ------------------------------------------------------------------------------
# SQLite path for BaselineStore and VerdictLogStore. Schema is created by
# scripts/apply_migrations.py, never by application code (R4.4 rule 5).
TALOS_DB_PATH=talos.db
