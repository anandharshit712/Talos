# Copy to .env and fill in. Never commit .env -- it is git-ignored (R1.1).
# Secrets live only in the environment; config/*.yaml never contains a credential.
#
# Two kinds of setting exist, and they live in different places on purpose:
#
#   .env               secrets, and the handful of paths that differ per machine
#   config/local.yaml  behaviour -- thresholds, sinks, domains, tuning
#
# Everything in config/ is ALSO reachable from here (see "Overriding config" at the bottom),
# but prefer local.yaml for behaviour. A value that lives in two places is a value that drifts.
# Precedence, lowest first:
#   default.yaml < thresholds.yaml < model_routing.yaml < local.yaml < TALOS_* environment


# ==============================================================================================
# 1. LLM access -- the only true secrets
# ==============================================================================================
# Keys only. Endpoints live in config/model_routing.yaml -> talos.providers, which names the
# variable each key comes from; nothing here is read except through that mapping.
#
# All three are optional. A provider whose key is missing or blank is simply absent from the
# router, so one key gets you that provider and templated narratives everywhere else. No key
# at all is a supported mode, not a broken one -- every detector still fires statistically and
# every verdict reports used_llm=false.

# NVIDIA NIM -- primary for most tiers. Key at https://build.nvidia.com
TALOS_NIM_API_KEY=

# Groq -- fallback. No card, no training clause, 200K tokens/day per model.
TALOS_GROQ_API_KEY=

# Mistral -- fallback, and primary for the code tier. Free "Experiment" tier, ~1B tokens/month,
# requires opting in to data training.
TALOS_MISTRAL_API_KEY=


# ==============================================================================================
# 2. Runtime -- paths and level. All optional; the shown value is the default.
# ==============================================================================================

# Directory holding default.yaml, thresholds.yaml, and model_routing.yaml.
# Set only when running from outside the repository.
#   values: any directory path            default: <repo>/config
TALOS_CONFIG_DIR=config

# Overlay merged on top of the files in that directory. Git-ignored when it exists.
#   values: any file path                 default: <TALOS_CONFIG_DIR>/local.yaml
TALOS_CONFIG_PATH=config/local.yaml

# Root log level. Logs are JSON lines (core/logging_setup.py).
#   values: DEBUG | INFO | WARNING | ERROR
TALOS_LOG_LEVEL=INFO

# SQLite file for VerdictLogStore. Schema comes from scripts/apply_migrations.py, never from
# application code (R4.4 rule 5). Becomes a PostgreSQL DSN at P6 -- see the tracker.
#   values: any file path                 default: talos.db
TALOS_DB_PATH=talos.db


# ==============================================================================================
# 3. Overriding config from the environment
# ==============================================================================================
# Any key in the config tree maps to TALOS_<SECTION>__<KEY>, nesting with a DOUBLE underscore.
# Lists and dicts take JSON. These beat local.yaml, which is what makes them useful in CI and
# in a shell one-liner -- and what makes them the wrong home for a permanent setting.
#
# Everything below is COMMENTED OUT on purpose. The value shown is the current default.

# --- Which domains run -------------------------------------------------------------------
#   values: JSON list drawn from web, network. Unknown domain = fatal ConfigError at load.
TALOS_ENABLED_DOMAINS=["web","network"]

# --- LLM behaviour (talos.llm) -------------------------------------------------------------
# Master switch. false skips every provider even when the keys above are set, so the whole
# pipeline runs its statistical path. Use this to demonstrate the no-model mode; do not
# delete your keys to do it.
#   values: true | false                  default: true
TALOS_LLM__ENABLED=true
#
# Per-request timeout, seconds. Must be > 0.
#   values: float                         default: 20.0
TALOS_LLM__REQUEST_TIMEOUT_SECONDS=20.0
#
# Retries on timeout / 5xx / 429 before falling back to the other provider. Never retries a
# 401 or a 404 -- those do not get better.
#   values: integer >= 0                  default: 1
TALOS_LLM__MAX_RETRIES=1
#
# Confidence multiplier when a fallback model answered instead of the primary.
#   values: float in (0.0, 1.0]           default: 0.85
TALOS_LLM__FALLBACK_CONFIDENCE_PENALTY=0.85
#
# Attacker-controlled telemetry is truncated to this many characters before being embedded in
# a prompt as delimited data (HLD 11/13). Lower is safer and cheaper; too low blinds the judge.
#   values: integer > 0                   default: 2000
TALOS_LLM__MAX_PAYLOAD_CHARS=2000

# --- Classification (talos.classifier) -----------------------------------------------------
# A category resolved below this confidence is routed as "unclassified" instead.
#   values: float in [0.0, 1.0]           default: 0.35
TALOS_CLASSIFIER__MIN_CONFIDENCE_FLOOR=0.35

# --- Incident aggregation (talos.aggregation) ----------------------------------------------
# Each extra independent detector agreeing nudges incident confidence up from the highest
# single verdict.
#   values: float in [0.0, 1.0]           default: 0.05
TALOS_AGGREGATION__CORROBORATION_BOOST=0.05
#
# Report an ongoing attack once, then again only when it escalates. false shows every firing,
# which is noisy but useful when you are debugging a detector.
#   values: true | false                  default: true
TALOS_AGGREGATION__SUPPRESS_DUPLICATES=true
#
# "Escalated" means it succeeded, or the attempt count grew by this factor.
#   values: float >= 1.0                  default: 2.0
TALOS_AGGREGATION__ESCALATION_ATTEMPT_FACTOR=2.0

# --- Event window (talos.storage) ----------------------------------------------------------
# TTL is measured in EVENT time, not wall-clock, so replaying a historical log behaves exactly
# like reading a live stream. Both bounds exist so a long replay cannot grow without limit.
#   values: integer > 0 (seconds)         default: 900
TALOS_STORAGE__EVENT_WINDOW_TTL_SECONDS=900
#   values: integer > 0, per key          default: 2000
TALOS_STORAGE__EVENT_WINDOW_MAX_EVENTS=2000

# --- Output (talos.output) -----------------------------------------------------------------
#   values: JSON list drawn from stdout, json_file
TALOS_OUTPUT__SINKS=["stdout","json_file"]
#   values: any directory path            default: out/reports
TALOS_OUTPUT__REPORT_DIR=out/reports

# --- Detector thresholds (talos.detection, see config/thresholds.yaml) ---------------------
# One block per detector family. Handy for a hand-written fixture that is too short to trip a
# production threshold; for anything lasting, put it in config/local.yaml instead.
TALOS_DETECTION__SSH_BRUTE_FORCE__FAIL_THRESHOLD=8
TALOS_DETECTION__SSH_BRUTE_FORCE__WINDOW_SECONDS=120
