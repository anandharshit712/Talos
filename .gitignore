# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Secrets and local overrides (R1: .env.example is committed, .env never is)
.env
.env.*
!.env.example
config/local.yaml

# Runtime artifacts
*.log
# ...but labelled test corpora are source, not runtime output (standards 3.6). So are the demo
# chains: `talos demo` reads them, so a clone without them is a clone where the P9 demo -- the
# whole submission -- crashes on a missing file. Found by running the quickstart in a fresh clone.
!tests/fixtures/logs/*.log
!data/samples/*.log
!docs/submission/*.log
*.db
*.sqlite
*.sqlite3
out/
reports/

# Editors / OS
.idea/
.DS_Store
Thumbs.db
ui/node_modules/
ui/dist/
ui/*.tsbuildinfo
